# =============================================================================
# Scholar — environment variables
# Copy this file to .env and fill in your keys.
# =============================================================================

# -----------------------------------------------------------------------------
# Google AI Studio (Gemini) — PRIMARY LLM + EMBEDDINGS
# Free tier: 1,500 requests/day on Gemini 2.5 Flash, no credit card required.
# Get a key at: https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=AIza...

# -----------------------------------------------------------------------------
# Groq — OPTIONAL alternative for fast Llama inference
# Free tier: ~30 requests/min on Llama 3.3 70B, lightning fast.
# Get a key at: https://console.groq.com/keys
# Leave blank if you don't want to set it up — examples will skip Groq sections.
# -----------------------------------------------------------------------------
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# LangSmith — observability (HIGHLY recommended, also free)
# Get a key at: https://smith.langchain.com (Settings → API Keys)
# -----------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=scholar-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# -----------------------------------------------------------------------------
# App config
# -----------------------------------------------------------------------------
SCHOLAR_DATA_DIR=./data
SCHOLAR_LOG_LEVEL=INFO
